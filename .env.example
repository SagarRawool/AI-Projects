# ==========================================
# JIRA CONFIGURATION
# ==========================================
# For Jira Cloud: https://your-domain.atlassian.net
# For Jira Server/DC: https://jira.yourcompany.com
JIRA_BASE_URL=https://your-domain.atlassian.net

# Authentication type: "basic" (Cloud: email + API token) or "bearer" (Server/DC: PAT)
JIRA_AUTH_TYPE=basic

# Jira Cloud credentials:
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Jira Server / Data Center Personal Access Token (PAT):
# JIRA_PAT=your_personal_access_token_here

# Default Jira Project Key (Optional)
JIRA_PROJECT_KEY=PROJ

# ==========================================
# LLM ENGINE CONFIGURATION
# ==========================================
# Options: "gemini", "openai", "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Offline mock mode for deterministic testing without external API calls
MOCK_MODE=false

